{
	"name": "@leogomide/multi-claude",
	"version": "2.1.0",
	"description": "CLI tool to manage multiple API providers and launch Claude Code with the correct environment variables",
	"license": "MIT",
	"author": "Leonardo Gomide",
	"repository": {
		"type": "git",
		"url": "https://github.com/leogomide/multi-claude"
	},
	"keywords": [
		"claude",
		"claude-code",
		"cli",
		"anthropic",
		"multi-provider",
		"tui"
	],
	"files": [
		"dist/",
		"CHANGELOG.md"
	],
	"type": "module",
	"bin": {
		"mclaude": "dist/cli.js"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:watch": "node scripts/build.mjs --watch",
		"dev": "node scripts/build.mjs && node dist/cli.js",
		"prepare": "node scripts/build.mjs",
		"prepublishOnly": "pnpm check-types && pnpm test && pnpm build",
		"link": "pnpm link --global",
		"check-types": "tsc --noEmit",
		"lint": "biome check --fix .",
		"lint:ci": "biome ci .",
		"test": "vitest run"
	},
	"packageManager": "pnpm@10.34.3",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^22.20.2",
		"@types/react": "19.2.14",
		"esbuild": "^0.28.2",
		"ink-testing-library": "4.0.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@inkjs/ui": "2.0.0",
		"cross-spawn": "^7.0.6",
		"dotenv": "17.4.2",
		"ink": "6.8.0",
		"ink-select-input": "6.2.0",
		"ink-text-input": "6.0.0",
		"react": "19.2.4",
		"rosetta": "1.1.0",
		"zod": "4.3.6"
	}
}
