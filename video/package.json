{
	"name": "mclaude-video",
	"private": true,
	"scripts": {
		"dev": "remotion studio",
		"build": "npm run build:en && npm run build:pt",
		"build:en": "remotion render MainEN out/mclaude-demo-en.mp4",
		"build:pt": "remotion render MainPT out/mclaude-demo-pt.mp4",
		"build:gif": "remotion render MainEN out/mclaude-demo.gif --codec=gif --every-nth-frame=2 --width=900",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@remotion/cli": "^4",
		"@remotion/transitions": "^4",
		"@remotion/google-fonts": "^4",
		"react": "^19",
		"react-dom": "^19",
		"remotion": "^4"
	},
	"devDependencies": {
		"@types/react": "^19",
		"typescript": "^5"
	}
}
